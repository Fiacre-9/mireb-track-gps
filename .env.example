# Copiez ce fichier en .env (local) ou saisissez ces variables dans hPanel > Node.js > Variables d'environnement.
# Ne committez JAMAIS le vrai .env.
NODE_ENV=production
PORT=3000

# Base MySQL (hPanel > Bases de données)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret de signature des sessions : chaîne aléatoire de 32 caractères ou plus
JWT_SECRET=

# Premier démarrage : compte super admin (si le mot de passe est vide, il est généré et affiché dans les logs)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# 1 = cookies réservés au HTTPS (par défaut en production)
COOKIE_SECURE=1

# Minutes sans signal avant « hors ligne » / jours de conservation de l'historique
OFFLINE_MINUTES=5
RETENTION_DAYS=90

# Boîtiers GPS GT06 en TCP (VPS uniquement : port à ouvrir dans le pare-feu). Laisser vide sur l'hébergement mutualisé.
GT06_PORT=
# Coupure carburant refusée / différée au-dessus de cette vitesse (km/h), comme le font les boîtiers
CUT_MAX_SPEED=20
# Textes de commande du boîtier (mot de passe par défaut 000000 : à adapter à votre modèle)
GT06_CMD_CUT=DYD,000000#
GT06_CMD_RESTORE=HFYD,000000#
# Une commande en attente expire après ce délai (minutes)
COMMAND_TTL_MINUTES=60

# Démonstration uniquement (NE PAS activer en production réelle)
DEMO=0
SIMULATOR=0
